# Copy to .env for local development. Set passwords before the first Compose start.
# Existing PostgreSQL volumes require their existing credentials.
DATABASE_NAME=hearforthevibes
DATABASE_USERNAME=hearforthevibes
DATABASE_PASSWORD=replace-with-local-development-password
TEST_DATABASE_NAME=hearforthevibes_test
TEST_DATABASE_USERNAME=hearforthevibes_test
TEST_DATABASE_PASSWORD=replace-with-local-test-password

# Compose supplies local JDBC URLs. Host runs must export DATABASE_URL separately.
# For production, set DATABASE_URL, DATABASE_USERNAME, and DATABASE_PASSWORD in
# the backend host's environment. See README.md for Supabase session pooler setup.
# DATABASE_URL='jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require&currentSchema=app'
# DATABASE_USERNAME=postgres.YOUR_PROJECT_REF
# DATABASE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
# Keep production credentials out of this file and never point tests at production.
